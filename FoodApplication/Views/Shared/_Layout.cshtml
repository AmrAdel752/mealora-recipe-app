@{
    var pageTitle = ViewData["Title"];
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(pageTitle is null ? "Mealora" : $"{pageTitle} | Mealora")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodApplication.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/jquery-ui.min.css" />
</head>
<body>
    <a class="skip-link" href="#mainContent">Skip to main content</a>
    <header class="position-sticky top-0 app-header">
        <nav class="navbar navbar-expand-md navbar-light app-navbar" aria-label="Primary navigation">
            <div class="container-fluid app-shell">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-mark" aria-hidden="true"><i class="fa-solid fa-utensils"></i></span>
                    <span>
                        <span class="app-brand-name">Mealora</span>
                        <span class="app-brand-tagline">Discover. Cook. Enjoy.</span>
                    </span>
                </a>
                <button class="navbar-toggler app-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavigation" aria-controls="primaryNavigation"
                        aria-expanded="false" aria-label="Toggle primary navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse app-nav-collapse" id="primaryNavigation">
                    <ul class="navbar-nav app-primary-nav">
                        <li class="nav-item">
                            <a class="nav-link fw-bold @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@(currentController == "Home" ? "page" : null)">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold @(currentController == "Recipe" ? "active" : "")" asp-area="" asp-controller="Recipe" asp-action="Index" aria-current="@(currentController == "Recipe" ? "page" : null)">Recipes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold @(currentController == "Favorites" ? "active" : "")" asp-area="" asp-controller="Favorites" asp-action="Index" aria-current="@(currentController == "Favorites" ? "page" : null)">Favorites</a>
                        </li>
                    </ul>
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <div class="nav-actions">
                            <div class="cart-preview-wrap">
                                <a class="icon-btn @(currentController == "Cart" ? "active" : "")" id="cartIconList" asp-controller="Cart" asp-action="Index" aria-label="Open cart" aria-current="@(currentController == "Cart" ? "page" : null)">
                                    <i class="fa-solid fa-cart-shopping fs-5" aria-hidden="true"></i>
                                </a>
                                <div id="showCartList" class="position-absolute" aria-label="Cart preview" aria-live="polite">
                                </div>
                            </div>
                            <a class="nav-link fw-bold" asp-controller="Account" asp-action="LogOut">Logout</a>
                        </div>
                    }
                    else
                    {
                        <div class="nav-actions">
                            <a class="nav-link fw-bold @(currentController == "Account" ? "active" : "")" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-primary nav-cta" asp-controller="Account" asp-action="Register">Create Account</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="page-wrap">
        <main id="mainContent" role="main" class="pb-4" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container app-shell py-4">
            <div class="row gy-4 align-items-start">
                <div class="col-md-5">
                    <h4>Mealora</h4>
                    <p>Discover. Cook. Enjoy.</p>
                </div>
                <div class="col-md-3">
                    <h5>Navigation</h5>
                    <nav class="footer-nav" aria-label="Footer navigation">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Recipe" asp-action="Index">Recipes</a>
                        <a asp-controller="Favorites" asp-action="Index">Favorites</a>
                    </nav>
                </div>
                <div class="col-md-4">
                    <h5>Recipe Data</h5>
                    <p>Recipe data powered by Forkify API.</p>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; Mealora. Built as a recipe discovery experience.</span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jquery-ui.min.js"></script>
    @if(User.Identity!.IsAuthenticated)
    {
        <script type="text/javascript">
            $(document).ready(function(){
                initializeStorageFeatures();
                getCartList();
            })
        </script>
    }
    else
    {
        <script type="text/javascript">
            $(document).ready(function(){
                initializeStorageFeatures();
            })
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
