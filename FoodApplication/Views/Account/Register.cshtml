@model FoodApplication.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section class="auth-page auth-page-register" aria-labelledby="registerTitle">
    <div class="auth-card">
        <div class="auth-form-panel">
            <div class="auth-form-header">
                <p class="eyebrow">Join Mealora</p>
                <h1 id="registerTitle">Create your Mealora account</h1>
                <p>Save recipes and enjoy a more personal recipe experience.</p>
            </div>

            <form autocomplete="off" method="post" action="/Account/Register" class="auth-form">
                <div class="auth-validation" aria-live="assertive">
                    @Html.ValidationSummary(false, "", new { @class = "text-danger", role = "alert" })
                </div>

                <div class="form-field">
                    @Html.LabelFor(m => m.Name, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Your name", autocomplete = "name" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-validation-error", role = "alert" })
                </div>

                <div class="form-field">
                    @Html.LabelFor(m => m.Address, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Delivery address", autocomplete = "street-address" })
                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-validation-error", role = "alert" })
                </div>

                <div class="form-field">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "you@example.com", type = "email", autocomplete = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error", role = "alert" })
                </div>

                <div class="form-field">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    <div class="password-field">
                        @Html.TextBoxFor(m => m.Password, new { @class = "form-control", placeholder = "Create a password", type = "password", autocomplete = "new-password" })
                        <button class="password-toggle" type="button" data-password-toggle="Password" aria-label="Show password" aria-pressed="false">
                            <i class="fa-regular fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error", role = "alert" })
                </div>

                <button type="submit" class="btn btn-primary btn-lg auth-submit">
                    <span>Create Account</span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>

                <p class="auth-switch">
                    Already have an account?
                    <a asp-controller="Account" asp-action="Login">Sign In</a>
                </p>
            </form>
        </div>

        <aside class="auth-media-panel" aria-label="Mealora recipe inspiration">
            <img src="~/Images/CarouselImages/pexels-lisa-fotios-1279330.jpg" alt="A plated pasta recipe" />
            <div class="auth-media-copy">
                <span>Mealora</span>
                <strong>Keep your favorite recipes within easy reach.</strong>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll("[data-password-toggle]").forEach(function (button) {
            button.addEventListener("click", function () {
                var input = document.getElementById(button.getAttribute("data-password-toggle"));
                var isHidden = input.type === "password";
                input.type = isHidden ? "text" : "password";
                button.setAttribute("aria-pressed", isHidden.toString());
                button.setAttribute("aria-label", isHidden ? "Hide password" : "Show password");
                button.querySelector("i").className = isHidden ? "fa-regular fa-eye-slash" : "fa-regular fa-eye";
            });
        });
    </script>
}
