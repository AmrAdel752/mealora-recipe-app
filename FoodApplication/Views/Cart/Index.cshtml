@model IEnumerable<FoodApplication.Models.Cart>

@{
    ViewData["Title"] = "Your Cart";
    var cartItems = Model.ToList();
    var itemCount = cartItems.Count;
}

<div class="cart-page">
    <header class="cart-page-header">
        <p class="eyebrow">Mealora Cart</p>
        <h1>Your Cart</h1>
        @if (itemCount > 0)
        {
            <p>@itemCount saved @(itemCount == 1 ? "recipe" : "recipes") ready when you are.</p>
        }
        else
        {
            <p>Explore recipes and add something delicious.</p>
        }
    </header>

    @if (itemCount > 0)
    {
        <section class="cart-items" aria-label="Saved recipes">
            @foreach (var cart in cartItems)
            {
                var recipeTitle = string.IsNullOrWhiteSpace(cart.Title) ? "Untitled recipe" : cart.Title;
                var publisher = string.IsNullOrWhiteSpace(cart.Publisher) ? null : cart.Publisher;
                var recipeId = cart.RecipeId ?? "";
                var hasRecipeId = !string.IsNullOrWhiteSpace(recipeId);
                var recipeUrl = hasRecipeId ? $"/Recipe/Order?id={Uri.EscapeDataString(recipeId)}" : null;
                var hasImage = !string.IsNullOrWhiteSpace(cart.Image_url);

                <article class="cart-item">
                    @if (hasRecipeId)
                    {
                        <a class="cart-item-media @(hasImage ? "" : "recipe-card-media-fallback")" href="@recipeUrl" aria-label="View @recipeTitle">
                            @if (hasImage)
                            {
                                <img src="@cart.Image_url" alt="@recipeTitle" loading="lazy" onerror="this.parentElement.classList.add('recipe-card-media-fallback'); this.remove();" />
                            }
                        </a>
                    }
                    else
                    {
                        <div class="cart-item-media recipe-card-media-fallback" role="img" aria-label="Image unavailable for @recipeTitle"></div>
                    }

                    <div class="cart-item-body">
                        <div class="cart-item-copy">
                            @if (hasRecipeId)
                            {
                                <a href="@recipeUrl" class="cart-item-title">@recipeTitle</a>
                            }
                            else
                            {
                                <span class="cart-item-title">@recipeTitle</span>
                            }
                            @if (publisher is not null)
                            {
                                <p>@publisher</p>
                            }
                        </div>

                        <button type="button" class="removeCartBTN cart-remove-button" onclick="removeCartfromlist('@recipeId')" aria-label="Remove @recipeTitle" disabled="@(!hasRecipeId)">
                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                            <span>Remove</span>
                        </button>
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <section class="mealora-state recipe-state cart-empty-state" aria-labelledby="emptyCartTitle">
            <i class="fa-solid fa-cart-shopping mealora-state-icon" aria-hidden="true"></i>
            <h2 id="emptyCartTitle">Your cart is empty</h2>
            <p>Explore recipes and add something delicious.</p>
            <a class="btn btn-primary" asp-controller="Recipe" asp-action="Index">Explore Recipes</a>
        </section>
    }
</div>
